NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# base64-encoded 32 random bytes; generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# shared secret for /api/cron/* routes; generate like APP_ENCRYPTION_KEY
CRON_SECRET=
# optional: free key from https://www.wordfence.com/threat-intel/ (register, create API key).
# Without it, vulnerability matching is skipped (the rest of the security scan still runs).
WORDFENCE_API_KEY=
# optional: Google API key with PageSpeed Insights API enabled.
# Without it PSI still runs but is rate-limited much sooner.
GOOGLE_PSI_API_KEY=
# APP_URL is this app's public origin. Two independent consumers:
#   1. GeoGrid via n8n (optional — the built-in "stub" provider needs none of
#      the three below): it builds the callback URL sent to n8n.
#   2. User invitations (required in every deployed environment, not
#      optional there): inviteUserAction (src/app/(dashboard)/users/actions.ts)
#      falls back to http://localhost:3000 when this is unset, and builds the
#      invite link's redirectTo as `${APP_URL}/login`. Leave this unset in a
#      deployed environment and every invite link Supabase generates points
#      at localhost — the invite appears to succeed and is unusable by the
#      invitee. `${APP_URL}/login` (and any other redirect target this app
#      uses) must also be added to Supabase Auth's redirect URL allow-list
#      (Authentication > URL Configuration), or Supabase rejects the
#      generateLink call's redirectTo regardless of what this variable is set to.
APP_URL=
N8N_GEOGRID_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# MCP_EDGE_SECRET is optional, and only needed for a site behind a CDN that
# challenges this app's traffic (see docs/ops/cloudflare.md). When set, every
# MCP request carries it in the X-OCS-Panel-Key header so an edge rule can
# recognise our traffic by something unguessable rather than by the
# User-Agent, which is published in this repository.
#
# It is NOT authentication and grants nothing: WordPress still requires the
# application password, and an unauthenticated request answers 401 with or
# without this header. Generate with:  openssl rand -hex 32
MCP_EDGE_SECRET=
