NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# base64-encoded 32 random bytes; generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# shared secret for /api/cron/* routes; generate like APP_ENCRYPTION_KEY
CRON_SECRET=
# optional: free key from https://www.wordfence.com/threat-intel/ (register, create API key).
# Without it, vulnerability matching is skipped (the rest of the security scan still runs).
WORDFENCE_API_KEY=
# optional: Google API key with PageSpeed Insights API enabled.
# Without it PSI still runs but is rate-limited much sooner.
GOOGLE_PSI_API_KEY=
